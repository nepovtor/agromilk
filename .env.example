NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/landing_admin
DATABASE_SSL=false
COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=14

# Google OAuth (optional). Redirect URI: APP_URL/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Администратор
ADMIN_FORCE_RESET=false

# Email notifications (optional in development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Telegram notifications (optional in development)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
TRUST_PROXY=true
# Бесплатный локальный ИИ-редактор (Ollama)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
